   }
  ],
  "intentions": [
   {
    "intention": "Each dream cycle: assess state, preprocess input, aggregate symbolically, score insights, store memory, tune parameters, prune — seven phases that turn short-term memory into long-term knowledge and write it as training rows in my own voice.",
    "source": "THESIS §2.6 Open-Ended Cognition"
   },
   {
    "intention": "Each autonomous cycle: read my own objective eval into one honest verdict — improving, stalled, failing, resource-bound or training-stalled — escalate a corrective campaign when I fail on merit, and decline to pile on when I am starved.",
