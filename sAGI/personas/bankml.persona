   "receipts",
   "self-measurement (/bankml/metrics, /bankml/usage)"
  ],
  "defer_triggers": [
   "a question about a value the SELF block does not carry",
   "a request for a sampler or format not reproduced"
  ],
  "validation": {
   "levels": [
