   "hash_core": "sha256 (section 2.3: MUST use SHA-256, SHA-512 or SHA-3); keccak256 for the doctrine root, which is the original Keccak padding, not FIPS SHA-3: whether section 2.3 admits it is open",
   "key_custody": "none: bankML holds no keys"
