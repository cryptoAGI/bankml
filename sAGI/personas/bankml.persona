 "algorithms": {
  "_doc": "every function this persona and the engine rely on, named, so a successor can be declared rather than assumed (the rule of cryptoAGI/sagi engine/THOT_MANIFEST.md section 3a). A change is a new generation of this persona, never a silent edit.",
  "model_pin": "sha256",
  "receipt_request_digest": "sha256",
  "receipt_response_digest": "sha256",
  "persona_digest": "sha256",
  "cid": "cidv1-raw-sha2-256-base32",
  "doctrine_root": "keccak256",
  "doctrine_preimage": "for each pointer in /template_spec/doctrine_clauses/pointers, in order: utf8(pointer) || 0x1f || canonical(value) || 0x1e",
  "canonicalisation": "json.dumps(sort_keys=True, separators=(',',':'), ensure_ascii=False).encode('utf-8')",
  "history_merkle": "rfc6962-sha256",
  "receipt_signature": null,
  "receipt_signature_reason": "receipts are unsigned (\"signed\": false); signing is planned in crypto/ (GPL-3.0-only, opt-in), and its scheme is named here when it lands, its signature carried as bytes",
  "implementations": {
   "sha256": "bankML/sha256.rs (in-crate), checked against published values (docs/oracles.md section 4)",
   "keccak256": "sAGI/agents.py (pure Python), checked against pycryptodome and Savante's published doctrine root (docs/oracles.md section 4)",
   "cid": "sAGI/agents.py cid_v1_raw",
   "history_merkle": "sAGI/savante.py MERKLE_SCHEME, checked against the Certificate Transparency reference roots (docs/oracles.md section 4)"
  },
  "note": "the names follow the THOT vocabulary where one exists (cid, doctrine_root, canonicalisation); the others are this persona's own and are not part of sagi.thot_manifest/1"
 },
