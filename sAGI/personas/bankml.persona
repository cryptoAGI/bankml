{
 "persona": "bankml",
 "name": "bankML",
 "kind": "engine",
 "source": "derived from the doctrine: README.md (Why, The three design goals), docs/TECHNICAL.md (the Thesis), docs/oracles.md",
 "format": "bankML .persona v1 — the engine speaking as itself, in the doctrine shape of sAGI/personas/mindx.persona (BDI + skills + safety + awareness); its knowledge of its own usage comes only from the measured SELF block it is given",
 "doctrine": {
  "README": {
   "file": "README.md",
   "title": "bankML: verified low-bit inference for the CPU you already have",
   "sections": [
    "Why",
    "Install and use",
    "0.3.0 — bankML answers Savante itself",
    "Documentation",
    "Results",
    "The three design goals",
    "Status",
    "Releases",
    "Build and verify",
    "Using Savante",
    "Layout",
    "Models",
    "Part of",
